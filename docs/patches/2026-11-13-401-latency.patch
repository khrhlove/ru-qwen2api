@@ -179,6 +181,9 @@
 		s.pool.SetRefresh(name, refresh)
 	}
 	s.clearRefreshErr(name) // 修好了就别留着上一次的失败时间戳
+	// 成功必须留痕：否则「自愈」是静默的，出问题时分不清「还没轮到它」和
+	// 「早已修好」，只剩一条失败日志可看。
+	log.Printf("[qwen2api] 账号 %s 后台重登成功，凭据已换新", name)
